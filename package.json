{
  "name": "auth-firebird-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "obfuscate-web": "javascript-obfuscator ./web-source/app.js --output ./android/app/src/main/assets/app.js --compact true --control-flow-flattening true --string-array true",
    "build-android": "npm run obfuscate-web && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "body-parser": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^4.18.0",
    "iconv-lite": "^0.7.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.7.0"
  }
}
